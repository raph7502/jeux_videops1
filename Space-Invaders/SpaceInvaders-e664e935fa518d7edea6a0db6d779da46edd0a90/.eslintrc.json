{
    "root": true,
    "extends": [
        "google",
        "plugin:@typescript-eslint/recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "plugins": [
        "@typescript-eslint"
    ],
    "env": {
        "browser": true,
        "es2021": true,
        "jest": true,
        "node": true
    },
    "ignorePatterns": [
        "node_modules/",
        "build/",
        "dist/",
        "playwright-report/",
        "test-results/"
    ],
    "rules": {
        "require-jsdoc": "off",
        "valid-jsdoc": "off",
        "indent": [
            "error",
            2
        ],
        "no-unused-vars": "off",
        "@typescript-eslint/no-unused-vars": [
            "error"
        ]
    }
}